---
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';

const {
  title,
  desc = 'ShareTrace：国家队 ETF 份额申赎、指数 K 线与买卖点',
  current = '',
  echarts = false,
} = Astro.props;

const nav = [
  ['home', '今日动态', '/index.html'],
  ['indices', '分指数', '/indices.html'],
  ['signals', '信号', '/signals.html'],
  ['history', '历史', '/history.html'],
  ['about', '口径说明', '/about.html'],
];
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
  </head>
  <body>
    <header class="shell">
      <div class="wrap">
        <a class="mark" href="/index.html">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <rect x="1" y="11" width="4" height="8" rx="1" fill="#0a0a0a" opacity=".22"></rect>
            <rect x="7" y="7" width="4" height="12" rx="1" fill="#0a0a0a" opacity=".5"></rect>
            <rect x="13" y="2" width="4" height="17" rx="1" fill="#1d5fbf"></rect>
          </svg>
          <span class="name">ShareTrace</span>
          <span class="scope">43 个指数 · 57 只 ETF · 份额口径</span>
        </a>
        <nav class="main">
          {nav.map(([key, label, href]) => (
            <a href={href} aria-current={key === current ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>数据源：上交所 ETF 归档 / 深交所 / 同花顺 · 行情 baostock · 份额为基金总份额，不是成交额。</p>
        <p>本站只做数据呈现，不构成投资建议。份额变化能说明资金进出，不能证明是国家队在买。</p>
      </div>
    </footer>
    {echarts && <script is:inline src="/assets/echarts.min.js"></script>}
  </body>
</html>
