---
import Base from '../layouts/Base.astro';
import { marketToday, footprint, load } from '../lib/data.mjs';
import { num, signed } from '../lib/format.mjs';

const { meta } = load();
const t = marketToday();
const fp = footprint();
const byMonth = new Map();
for (const d of t.history) {
  const key = d.date.slice(0, 7);
  let m = byMonth.get(key);
  if (!m) byMonth.set(key, (m = { month: key, flow: 0, inDays: 0, outDays: 0, maxAbs: 0, maxDate: d.date, n: 0 }));
  m.flow += d.flow;
  m.n += 1;
  if (d.flow > 0) m.inDays += 1;
  else if (d.flow < 0) m.outDays += 1;
  if (Math.abs(d.flow) > m.maxAbs) {
    m.maxAbs = Math.abs(d.flow);
    m.maxDate = d.date;
  }
}
const months = [...byMonth.values()]
  .map((m) => ({ ...m, flow: Math.round(m.flow * 100) / 100 }))
  .sort((a, b) => (a.month < b.month ? 1 : -1));

const best = months.reduce((a, b) => (b.flow > a.flow ? b : a), months[0] ?? null);
const worst = months.reduce((a, b) => (b.flow < a.flow ? b : a), months[0] ?? null);

const years = [...new Set(months.map((m) => m.month.slice(0, 4)))].sort().reverse();
const byYear = years.map((y) => {
  const ys = months.filter((m) => m.month.startsWith(y));
  return { year: y, rows: ys, flow: Math.round(ys.reduce((s, m) => s + m.flow, 0) * 100) / 100 };
});

const asc = months.slice().reverse();
const chart = { labels: asc.map((m) => m.month.slice(2)), values: asc.map((m) => m.flow) };
const generated = meta.generated_at.slice(0, 16).replace('T', ' ');
---
<Base title="ShareTrace · 逐日历史" current="history" stamp={{ date: t.date, generated }}>
  <div class="head reveal">
    <div>
      <h1>逐日历史</h1>
      <p class="meta">
        沪市 <span class="fig">47</span> 只国家队 ETF 的合计净申赎，{t.history[0]?.date} 起共
        <span class="fig">{t.history.length}</span> 个交易日，按自然月汇总。逐日明细给 CSV。
      </p>
    </div>
    <div class="right">
      <b>{months.length}</b> 个月<br />
      <b>{new Date(t.date).getFullYear() - Number(t.history[0]?.date.slice(0, 4)) + 1}</b> 个自然年
    </div>
  </div>

  <div class="statrow reveal">
    <div>
      <div class="k">最强月</div>
      <div class="v">{signed(best.flow, 0)}</div>
      <div class="s">{best.month} · 亿元</div>
    </div>
    <div>
      <div class="k">最弱月</div>
      <div class="v">{signed(worst.flow, 0)}</div>
      <div class="s">{worst.month} · 亿元</div>
    </div>
    <div>
      <div class="k">净申购月份</div>
      <div class="v">{months.filter((m) => m.flow > 0).length} <span class="u">/ {months.length}</span></div>
      <div class="s">按月看，正负月份的比例</div>
    </div>
    <div>
      <div class="k">单日最大</div>
      <div class="v">{signed(fp.max, 0)}</div>
      <div class="s">亿元 · 2012 年以来</div>
    </div>
  </div>

  <section class="panel reveal" style="margin-top:24px">
    <div class="panel-head">
      <h2>按月合计</h2>
      <span class="note">上为净申购，下为净赎回 · 亿元</span>
    </div>
    <div id="monthChart" class="chart"></div>
  </section>

  <div class="mhead" aria-hidden="true">
    <span>月份</span>
    <span class="num">净申赎</span>
    <span class="num">交易日</span>
    <span class="num">申购 / 赎回天数</span>
    <span class="num">单日最大</span>
  </div>

  {byYear.map((y) => (
    <section class="band reveal">
      <div class="band-head">
        <h2>{y.year} <span class="cnt">{y.rows.length} 个月</span></h2>
        <span class="side">全年 <span class="fig">{signed(y.flow)}</span> 亿</span>
      </div>
      <div class="mlist">
        {y.rows.map((m) => (
          <div class="mrow">
            <span class="mm">{m.month}</span>
            <span class="mv">{signed(m.flow)}</span>
            <span class="mv m">{m.n}</span>
            <span class="mv m">{m.inDays} / {m.outDays}</span>
            <span class="mv m">{m.maxDate.slice(5)} · {num(m.maxAbs, 0)}</span>
          </div>
        ))}
      </div>
    </section>
  ))}

  <p class="tail">
    这里只含沪市 47 只（有连续份额历史）；深市 10 只 2026-10-21 起才进当日数据，不进历史序列。
    <a href="/data/history.csv">下载逐日明细 CSV →</a>
  </p>

  <script is:inline type="application/json" id="month-data" set:html={JSON.stringify(chart)} />
  <script is:inline src="/assets/charts.js"></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('monthChart');
      var raw = document.getElementById('month-data');
      if (!el || !raw || !window.Charts) return;
      var d = JSON.parse(raw.textContent);
      function draw() {
        Charts.diverging(el, {
          labels: d.labels,
          values: d.values,
          above: '净申购',
          below: '净赎回',
          format: function (v) { return Math.abs(v) >= 1000 ? Math.round(v / 100) / 10 + 'k' : Math.round(v); },
          height: 210,
          mark: [d.values.length - 1],
          markLabel: '本月',
          markSide: 'above'
        });
      }
      draw();
      var t;
      window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(draw, 160); });
    })();
  </script>
</Base>
