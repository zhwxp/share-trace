---
import Base from '../layouts/Base.astro';
import { marketToday } from '../lib/data.mjs';
import { num, signed, tone } from '../lib/format.mjs';

const t = marketToday();
const byMonth = new Map();
for (const d of t.history) {
  const key = d.date.slice(0, 7);
  let m = byMonth.get(key);
  if (!m) byMonth.set(key, (m = { month: key, flow: 0, inDays: 0, outDays: 0, maxAbs: 0, maxDate: d.date, n: 0 }));
  m.flow += d.flow;
  m.n += 1;
  if (d.flow > 0) m.inDays += 1;
  else if (d.flow < 0) m.outDays += 1;
  if (Math.abs(d.flow) > m.maxAbs) {
    m.maxAbs = Math.abs(d.flow);
    m.maxDate = d.date;
  }
}
const months = [...byMonth.values()]
  .map((m) => ({ ...m, flow: Math.round(m.flow * 100) / 100 }))
  .sort((a, b) => (a.month < b.month ? 1 : -1));

const best = months.reduce((a, b) => (b.flow > a.flow ? b : a), months[0] ?? null);
const worst = months.reduce((a, b) => (b.flow < a.flow ? b : a), months[0] ?? null);
---
<Base title="ShareTrace · 逐日历史" current="history">
  <h1>逐日历史</h1>
  <p class="lede">
    沪市国家队 ETF 合计净申赎，按自然月汇总，共 {t.history.length} 个交易日（{t.history[0]?.date} 起）。
    逐日明细见页面底部的 CSV。
  </p>

  {best && worst && (
    <p class="lede">
      最强月份 {best.month}（{signed(best.flow)} 亿元），最弱月份 {worst.month}（{signed(worst.flow)} 亿元）。
    </p>
  )}

  <div class="panel">
    <table class="tbl">
      <thead>
        <tr>
          <th>月份</th><th class="num">净申赎(亿)</th><th class="num">交易日</th>
          <th class="num">净申购天数</th><th class="num">净赎回天数</th><th>单日最大</th>
        </tr>
      </thead>
      <tbody>
        {months.map((m) => (
          <tr>
            <td>{m.month}</td>
            <td class={`num ${tone(m.flow)}`}>{signed(m.flow)}</td>
            <td class="num">{m.n}</td>
            <td class="num">{m.inDays}</td>
            <td class="num">{m.outDays}</td>
            <td>{m.maxDate} · {num(m.maxAbs)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="note">
    这里的合计只含沪市 47 只（有连续份额历史）；深市 10 只 2026-10-21 起才进当日数据，不进历史序列。
    <a href="/data/history.csv">下载逐日明细 CSV</a>。
  </p>
</Base>
