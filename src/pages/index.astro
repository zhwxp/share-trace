---
import Base from '../layouts/Base.astro';
import { load, marketToday, movers, eventsOn } from '../lib/data.mjs';
import { num, signed, side } from '../lib/format.mjs';

const { meta, latest, indices, bySlug, events } = load();
const t = marketToday();
const signals = eventsOn(latest).slice(0, 3);
const mv = movers(5);
const recent = t.history.slice(-20);

const generated = meta.generated_at.slice(0, 16).replace('T', ' ');

// 今天是空的就说上一次是什么，不留空框
const lastAny = events
  .filter((e) => e.date <= latest)
  .slice()
  .sort((a, b) => (a.date < b.date ? 1 : -1))[0];

const labels = recent.map((d) => d.date.slice(5));
const values = recent.map((d) => d.flow);
const chartPayload = { labels, values, today: labels.length - 1 };
---
<Base title="ShareTrace · 今日动态" current="home">
  <h1>今日动态</h1>
  <p class="lede">
    最新交易日 {latest} · 数据生成 {generated} · 沪市 {t.n} 只国家队 ETF
  </p>

  <div class="kpis">
    <div class="kpi">
      <div class="label">当日合计净申赎</div>
      <div class="value fig">{signed(t.flow)}<span class="unit">亿元</span></div>
      <div class="sub">{t.nIn} 只净申购 · {t.nOut} 只净赎回</div>
    </div>
    <div class="kpi">
      <div class="label">近 5 日</div>
      <div class="value fig">{signed(t.d5)}<span class="unit">亿元</span></div>
      <div class="sub">截至 {latest}</div>
    </div>
    <div class="kpi">
      <div class="label">近 20 日</div>
      <div class="value fig">{signed(t.d20)}<span class="unit">亿元</span></div>
      <div class="sub">沪市 {t.n} 只合计</div>
    </div>
  </div>

  <section class="chartcard" style="margin-top: 20px;">
    <div class="head">
      <h2>近 20 个交易日净申赎</h2>
      <span class="lede">上为净申购，下为净赎回 · 单位亿元</span>
    </div>
    <div id="flowChart" class="chart"></div>
  </section>

  <h2>今日信号 <span class="count">{signals.length ? `${signals.length} 个指数越过门槛` : '无'}</span></h2>
  {signals.length === 0 ? (
    <p class="empty">
      {latest} 没有指数达到触发门槛。
      {lastAny && `最近一次是 ${lastAny.date} 的${bySlug.get(lastAny.slug)?.name ?? lastAny.slug}，${side(lastAny.side)} ${signed(lastAny.amount, 0)} 亿元。`}
    </p>
  ) : (
    <div class="panel tight">
      <table class="tbl">
        <thead>
          <tr>
            <th>指数</th><th>方向</th><th class="num">当日(亿)</th>
            <th class="num hide-sm">门槛(亿)</th><th class="num hide-sm">成分 ETF</th><th class="num">共振</th>
          </tr>
        </thead>
        <tbody>
          {signals.map((e) => (
            <tr>
              <td><a href={`/index/${e.slug}.html`}>{bySlug.get(e.slug)?.name ?? e.slug}</a></td>
              <td><span class={`tag ${e.side > 0 ? 'buy' : 'sell'}`}>{side(e.side)}</span></td>
              <td class="num fig">{signed(e.amount)}</td>
              <td class="num fig hide-sm">{num(e.thr, 1)}</td>
              <td class="num fig hide-sm">{e.n}</td>
              <td class="num fig">{e.reson}/{e.n}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h2>ETF 异动前五 <span class="count">按当日净申赎绝对值</span></h2>
  <div class="panel tight">
    <table class="tbl">
      <thead>
        <tr>
          <th>ETF</th><th>市场</th><th class="num">当日净申赎(亿)</th>
          <th class="num">Δ份额(亿份)</th><th class="num">份额(亿份)</th>
        </tr>
      </thead>
      <tbody>
        {mv.map((m) => (
          <tr>
            <td>{m.etf.name} <span class="lede fig">{m.etf.code}</span></td>
            <td class="lede">{m.etf.market}</td>
            <td class="num fig">{signed(m.flow)}</td>
            <td class="num fig">{signed(m.d_share)}</td>
            <td class="num fig">{num(m.share, 2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    深市几只 ETF 的份额历史只有最近几个交易日，Δ份额 只对比相邻两天；完整名单见分指数页。
  </p>

  <div class="actions">
    <a class="btn" href="/indices.html">看全部 {indices.length} 个指数</a>
    <a class="btn ghost" href="/signals.html">全部 {events.length} 个历史信号</a>
  </div>

  <script is:inline type="application/json" id="flow-data" set:html={JSON.stringify(chartPayload)} />
  <script is:inline src="/assets/charts.js"></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('flowChart');
      var raw = document.getElementById('flow-data');
      if (!el || !raw || !window.Charts) return;
      var d = JSON.parse(raw.textContent);
      Charts.diverging(el, {
        labels: d.labels,
        values: d.values,
        above: '净申购',
        below: '净赎回',
        format: function (v) { return v >= 100 ? Math.round(v) : v.toFixed(0); },
        height: 190,
        mark: [d.today],
        markLabel: '今日',
        markSide: 'both'
      });
    })();
  </script>
</Base>
