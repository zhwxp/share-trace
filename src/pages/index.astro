---
import Base from '../layouts/Base.astro';
import { load, marketToday, eventsOn, streak } from '../lib/data.mjs';
import { signed, side } from '../lib/format.mjs';
import { V } from '../lib/asset.mjs';

const { meta, latest, bySlug, events } = load();
const t = marketToday();
const st = streak();
const signals = eventsOn(latest);

// 今日与近 20 个交易日共用同一个窗口
const recent = t.history.slice(-20);
const windowStart = recent[0].date;
const windowEvents = events.filter((e) => e.date >= windowStart);
const recentEv = windowEvents.slice().reverse();

// 点阵：一行一个指数，一列一个交易日
const dayAt = new Map(recent.map((d, i) => [d.date, i]));
const sums = new Map();
for (const e of windowEvents) sums.set(e.slug, (sums.get(e.slug) ?? 0) + Math.abs(e.amount));
const sigRows = [...new Set(windowEvents.map((e) => e.slug))]
  .sort((a, b) => sums.get(b) - sums.get(a))
  .map((slug) => {
    const name = bySlug.get(slug)?.name ?? slug;
    return {
      label: name,
      marks: windowEvents
        .filter((e) => e.slug === slug)
        .map((e) => ({
          at: dayAt.get(e.date),
          side: e.side,
          value: e.amount,
          title: `${name} · ${e.date} · ${side(e.side)} ${signed(e.amount)} 亿 · 历史第 ${e.rank} 强 / ${e.n_events} 次`,
        })),
    };
  });

const sigPayload = {
  days: recent.map((d) => d.date.slice(5)),
  rows: sigRows,
  today: recent.length - 1,
};

const generated = meta.generated_at.slice(0, 16).replace('T', ' ');

const streakText = st.days > 1
  ? `连续 ${st.days} 个交易日${st.sign > 0 ? '净申购' : '净赎回'}`
  : '今日转为' + (st.sign > 0 ? '净申购' : '净赎回');
---

<Base title="ShareTrace · 今日" current="home" stamp={{ date: latest, generated }}>
  <div class="head reveal">
    <div>
      <h1>今日</h1>
      <p class="meta"><span class="fig">{latest}</span> 收盘</p>
    </div>
  </div>

  <section class="panel reveal" style="margin-top:20px">
    <div class="herotop">
      <div class="lead">
        <span class="value {t.flow >= 0 ? 'up' : ''}">{signed(t.flow)}</span>
        <span class="unit">亿元 · {t.n} 只合计净申赎</span>
      </div>
      <p class="finding">
        {streakText}，20 日累计 <span class="fig">{signed(t.d20)}</span> 亿。
        <span class="fig">{t.nIn}</span> 只净申购、<span class="fig">{t.nOut}</span> 只净赎回。
      </p>
    </div>

    <div class="figrow" style="grid-template-columns:repeat(2,minmax(0,1fr))">
      <div>
        <div class="label">近 5 日 · 亿元</div>
        <div class="v">{signed(t.d5)}</div>
      </div>
      <div>
        <div class="label">近 20 日 · 亿元</div>
        <div class="v">{signed(t.d20)}</div>
      </div>
    </div>
  </section>

  <section class="band reveal">
    <div class="band-head">
      <h2>今日信号 <span class="cnt">{signals.length}</span></h2>
    </div>
    {signals.length === 0 ? (
      <p class="empty">今天没有指数达到触发门槛。</p>
    ) : (
      <div class="sigs">
        {signals.map((e) => (
          <a class="sig" href={`/index/${e.slug}.html`}>
            <span class="sn">{bySlug.get(e.slug)?.name ?? e.slug}</span>
            <span class={`pill ${e.side > 0 ? 'buy' : 'sell'}`}>{side(e.side)}</span>
            <span class="sv fig">{signed(e.amount)}</span>
            <span class="sm">历史第 {e.rank} 强 / {e.n_events} 次</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="band reveal">
    <div class="band-head">
      <h2>近 20 个交易日信号 <span class="cnt">{recentEv.length}</span></h2>
      <span class="side legendline">
        <span id="sig-legend"></span>
        <a href="/stats.html">统计 →</a>
      </span>
    </div>

    {recentEv.length === 0 ? (
      <p class="empty">近 20 个交易日没有指数达到触发门槛。</p>
    ) : (
      <>
        <div id="signalChart" class="chart"></div>
        <div class="sigs" style="margin-top:14px">
          {recentEv.map((e) => (
            <a class="sig quiet" href={`/index/${e.slug}.html`}>
              <span class="sn">{bySlug.get(e.slug)?.name ?? e.slug}</span>
              <span class={`pill ${e.side > 0 ? 'buy' : 'sell'}`}>{side(e.side)}</span>
              <span class="sv fig">{signed(e.amount)}</span>
              <span class="sm">{e.date} · 第 {e.rank} 强 / {e.n_events} 次</span>
            </a>
          ))}
        </div>
      </>
    )}
  </section>

  <script is:inline type="application/json" id="sig-data" set:html={JSON.stringify(sigPayload)} />
  <script is:inline src={`/assets/charts.js?v=${V}`}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('signalChart');
      var raw = document.getElementById('sig-data');
      if (!el || !raw || !window.Charts) return;
      var d = JSON.parse(raw.textContent);
      function draw() {
        Charts.signalDots(el, {
          days: d.days,
          rows: d.rows,
          today: d.today,
          above: '买入',
          below: '卖出',
          legend: '#sig-legend'
        });
      }
      draw();
      var t;
      window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(draw, 160); });
    })();
  </script>
</Base>
