---
import Base from '../../layouts/Base.astro';
import { load, indexStats } from '../../lib/data.mjs';
import { num, signed, side, pct } from '../../lib/format.mjs';
import { V } from '../../lib/asset.mjs';

export function getStaticPaths() {
  const { indices } = load();
  return indices.map((it) => ({ params: { slug: it.slug }, props: { it } }));
}

const { it } = Astro.props;
const { meta, byCode } = load();
const s = indexStats(it.slug);
const m = meta.indices[it.slug];
const params = meta.params;
const stale = meta.stale?.by_index?.[it.slug];
const detail = it.etfs.map((c) => byCode.get(c)).filter(Boolean);
const generated = meta.generated_at.slice(0, 16).replace('T', ' ');
---
<Base title={`${it.name} · ShareTrace`} current="indices" echarts stamp={{ date: meta.latest_trade_date, generated }}>
  <div class="head reveal">
    <div>
      <h1>{it.name}</h1>
      <p class="meta">
        {it.cat} · 成分 ETF <span class="fig">{detail.length}</span> 只 · 当日口径
        <span class="fig">{s.lastDate}</span> · 单位亿元
      </p>
    </div>
    <div class="right">
      <a href="/indices.html" style="color:var(--muted)">← 全部分指数</a><br />
      <b>{s.events.length}</b> 个历史信号
    </div>
  </div>

  <div class="statrow reveal">
    <div>
      <div class="k">当日净申赎</div>
      <div class="v">{signed(s.today)}</div>
      <div class="s">{s.lastDate} · 亿元</div>
    </div>
    <div>
      <div class="k">近 5 日</div>
      <div class="v">{signed(s.d5)}</div>
      <div class="s">亿元</div>
    </div>
    <div>
      <div class="k">近 20 日</div>
      <div class="v">{signed(s.d20)}</div>
      <div class="s">亿元</div>
    </div>
    <div>
      <div class="k">最近信号</div>
      <div class="v hl" style="font-size:18px">
        {s.lastEvent ? `${s.lastEvent.date.slice(2)} ${side(s.lastEvent.side)}` : '—'}
      </div>
      <div class="s">{s.lastEvent ? `${signed(s.lastEvent.amount, 0)} 亿元` : '还没有触发过'}</div>
    </div>
  </div>

  {stale && (
    <p class="notice reveal">
      这张图止于 {stale.last_date}，比最新份额日期少 {stale.lag_days} 个交易日——上游行情还没补上，不是份额没有变化。
    </p>
  )}
  {s.shortHistory && (
    <p class="notice reveal">
      成分 ETF 的份额历史只有 {m.flow_days} 个交易日，图上只画得出最近几天；历史序列不足，不出信号。
    </p>
  )}

  <section class="panel reveal" style="margin-top:22px">
    <div class="panel-head">
      <h2>价格与申赎</h2>
      <span class="note">
        {m.kline_source === 'index' ? '指数行情' : '代理 ETF 行情'} {m.kline_code} · 三角为信号点，面积越大金额越大
      </span>
    </div>
    <div class="legend" style="margin-bottom:10px">
      <span class="l"><i class="sw sw-candle"></i>K 线（涨红跌绿）</span>
      <span class="l"><i class="sw sw-ma20"></i>MA20</span>
      <span class="l"><i class="sw sw-ma60"></i>MA60</span>
      <span class="l"><i class="sw sw-flow"></i>日净申赎</span>
      <span class="l"><i class="sw sw-cum"></i>20 日累计</span>
      <span class="l"><i class="sw sw-ann"></i>国家队公告</span>
    </div>
    <div id="detailChart" class="chart chart-echarts" role="img" aria-label={`${it.name}的 K 线、均线、日净申赎与 20 日累计，标出 ${s.events.length} 个信号点`} data-src={`/data/index/${it.slug}.json`}></div>
    <p class="note" id="chart-status">图表载入中…</p>
  </section>

  <section class="band reveal">
    <div class="band-head">
      <h2>信号明细 <span class="cnt">{s.events.length}</span></h2>
      <span class="side">后 20 日为信号方向对应的指数涨跌，正数=有效</span>
    </div>
    {s.events.length === 0 ? (
      <p class="empty">这个指数还没有触发过信号。</p>
    ) : (
      <>
        <div class="shead" aria-hidden="true">
          <span>日期</span><span>方向</span><span class="num">当日</span>
          <span class="num">连续 / 合计</span><span class="num">门槛</span><span class="num">后 20 日</span>
        </div>
        <div class="slist">
          {s.events.map((e) => (
            <div class="srow" style="grid-template-columns:96px 56px minmax(0,1fr) 132px 96px 80px">
              <span class="sd">{e.date}</span>
              <span class={`pill ${e.side > 0 ? 'buy' : 'sell'}`}>{side(e.side)}</span>
              <span class="sv2">{signed(e.amount)}</span>
              <span class="sv2 m">{e.days} 天 / {signed(e.total, 0)}</span>
              <span class="sv2 m">{num(e.thr, 1)}</span>
              <span class={`sv2 ${e.post20 > 0 ? 'pos' : 'm'}`}>{e.post20 === null ? '—' : pct(e.post20, 1)}</span>
            </div>
          ))}
        </div>
      </>
    )}
  </section>

  <section class="band reveal">
    <div class="band-head">
      <h2>成分 ETF <span class="cnt">{detail.length}</span></h2>
      <span class="side">份额为最新交易日的基金总份额</span>
    </div>
    <div class="chead" aria-hidden="true">
      <span>代码</span><span>名称</span><span>档</span><span>市场</span><span class="num">份额（亿份）</span>
    </div>
    <div class="clist">
      {detail.map((e) => (
        <div class="crow">
          <span class="cn">{e.name}</span>
          <span class="cs">{num(e.share, 2)}</span>
          <span class="cmeta">
            <span class="cc">{e.code}</span>
            <span class="ct">{e.tier}</span>
            <span class="cm">{e.market}</span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <p class="tail">
    触发门槛 = max({params.floor_yi} 亿, {params.ratio * 100}% × 该指数 ETF 合计规模)，封顶 {params.cap_yi} 亿；
    成分 ETF 两只以上时要求同向只数 ≥ max(2, 60%)；{params.merge_days} 个交易日内同向连续触发合并为一个事件，
    标在当日金额最大的那天。<a href="/about.html">口径说明 →</a>
  </p>

  <script is:inline src={`/assets/kline.js?v=${V}`} defer></script>
  <script is:inline src={`/assets/detail.js?v=${V}`} defer></script>
</Base>
