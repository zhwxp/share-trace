---
import Base from '../layouts/Base.astro';
import { load, indexStats } from '../lib/data.mjs';
import { num, signed } from '../lib/format.mjs';

const { meta, indices, bySlug } = load();
const rows = indices.map((it) => ({ it, s: indexStats(it.slug) }));
const groups = meta.categories.map((cat) => ({
  cat,
  rows: rows.filter((r) => r.it.cat === cat).sort((a, b) => Math.abs(b.s.today ?? 0) - Math.abs(a.s.today ?? 0)),
}));
const totalEvents = meta.counts.events;
---
<Base title="ShareTrace · 分指数" current="indices">
  <h1>分指数</h1>
  <p class="lede">
    {indices.length} 个标的指数，按大类分组，组内按当日净申赎绝对值排序。当日口径为 {meta.latest_trade_date}。
  </p>

  {groups.map((g) => (
    <section>
      <h2>{g.cat}</h2>
      <div class="panel">
        <table class="tbl">
          <thead>
            <tr>
              <th>指数</th>
              <th class="num">当日(亿)</th>
              <th class="num">近 5 日(亿)</th>
              <th class="num">近 20 日(亿)</th>
              <th class="num">ETF 只数</th>
              <th class="num">事件</th>
              <th>最近信号</th>
            </tr>
          </thead>
          <tbody>
            {g.rows.map(({ it, s }) => (
              <tr>
                <td>
                  <a href={`/index/${it.slug}.html`}>{it.name}</a>
                  {s.shortHistory && <span class="lede"> · 份额历史不足</span>}
                </td>
                <td class="num fig">{signed(s.today)}</td>
                <td class="num fig">{signed(s.d5)}</td>
                <td class="num fig">{signed(s.d20)}</td>
                <td class="num fig">{s.nEtf ?? '—'}</td>
                <td class="num fig">{s.events.length}</td>
                <td>
                  {s.lastEvent
                    ? `${s.lastEvent.date} ${s.lastEvent.side > 0 ? '买' : '卖'} ${signed(s.lastEvent.amount, 0)}`
                    : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
  <p class="note">
    共 {totalEvents} 个信号事件。「份额历史不足」的指数只有最近几个交易日的份额数据，不参与历史序列。
  </p>
</Base>
