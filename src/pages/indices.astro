---
import Base from '../layouts/Base.astro';
import { load, indexStats } from '../lib/data.mjs';
import { signed } from '../lib/format.mjs';

const { meta, latest, indices } = load();
const rows = indices.map((it) => ({ it, s: indexStats(it.slug) }));
// 组内顺序固定：宽基按成分股市值（大盘→小盘），行业按指数代码，跨境、商品各自成组
const groups = meta.categories.map((cat) => ({
  cat,
  list: rows.filter((r) => r.it.cat === cat),
}));
const generated = meta.generated_at.slice(0, 16).replace('T', ' ');
---

<Base title="ShareTrace · 分指数" current="indices" stamp={{ date: latest, generated }}>
  <div class="head reveal">
    <div>
      <h1>分指数</h1>
      <p class="meta">
        {indices.length} 个标的指数，点进去看 K 线、买卖点和成分 ETF。单位亿元，当日口径
        <span class="fig">{latest}</span>。
      </p>
    </div>
  </div>

  {groups.map((g) => (
    <section class="band reveal">
      <div class="band-head">
        <h2>{g.cat} <span class="cnt">{g.list.length}</span></h2>
      </div>
      <div class="shead" aria-hidden="true">
        <span>指数</span><span class="num">当日</span><span class="num">近 5 日</span>
        <span class="num">近 20 日</span><span class="num">信号</span><span class="num">最近</span>
      </div>
      <div class="slist">
        {g.list.map(({ it, s }) => (
          <a class="srow" href={`/index/${it.slug}.html`}>
            <span class="sn2">{it.name}</span>
            <span class={`sv2 ${s.today >= 0 ? 'pos' : 'm'}`}>{signed(s.today)}</span>
            <span class="sv2 m">{signed(s.d5)}</span>
            <span class="sv2 m">{signed(s.d20)}</span>
            <span class="sv2 m">{s.events.length}</span>
            <span class="sv2 m">{s.lastEvent ? s.lastEvent.date.slice(2) : '—'}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p class="tail">
    信号门槛 = max({meta.params.floor_yi} 亿, {meta.params.ratio * 100}% × 该指数 ETF 合计规模)，封顶
    {meta.params.cap_yi} 亿。<a href="/about.html">口径说明 →</a>
  </p>
</Base>

<style>
  @media (min-width: 641px) {
    .shead, .srow {
      grid-template-columns: minmax(0, 1fr) 92px 92px 92px 56px 72px;
    }
  }
  @media (max-width: 640px) {
    .srow {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: none;
    }
    .srow > span {
      grid-area: auto;
    }
    .srow > span:nth-child(3),
    .srow > span:nth-child(4),
    .srow > span:nth-child(5),
    .srow > span:nth-child(6) {
      display: none;
    }
    .srow > span.sv2:nth-child(2) {
      display: block;
      text-align: right;
    }
  }
</style>
