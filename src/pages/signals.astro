---
import Base from '../layouts/Base.astro';
import { load, signalStats } from '../lib/data.mjs';
import { signed, side, pct } from '../lib/format.mjs';

const { events, bySlug, meta } = load();
const ss = signalStats();
const rows = events.slice().sort((a, b) => (a.date < b.date ? 1 : -1));
const years = [...new Set(rows.map((e) => e.date.slice(0, 4)))].sort().reverse();
const byYear = years.map((y) => {
  const ys = rows.filter((e) => e.date.startsWith(y));
  const done = ys.filter((e) => e.post20 !== null && e.post20 !== undefined);
  const hit = done.filter((e) => e.post20 > 0).length;
  return {
    year: y,
    rows: ys,
    buys: ys.filter((e) => e.side > 0).length,
    matured: done.length,
    hit,
    rate: done.length ? hit / done.length : null,
  };
});
const generated = meta.generated_at.slice(0, 16).replace('T', ' ');
---
<Base title="ShareTrace · 全部信号" current="signals" stamp={{ date: meta.latest_trade_date, generated }}>
  <div class="head reveal">
    <div>
      <h1>全部信号</h1>
      <p class="meta">
        {ss.first} 以来共 <span class="fig">{ss.total}</span> 个事件，按日期倒序。后 20 日为该信号方向对应的指数涨跌，
        正数表示信号有效；未满 20 个交易日的记作 —。
      </p>
    </div>
    <div class="right">
      <b>{meta.params.merge_days}</b> 个交易日合并<br />
      <b>{meta.params.floor_yi}</b> 亿起算
    </div>
  </div>

  <div class="statrow reveal">
    <div>
      <div class="k">事件</div>
      <div class="v">{ss.total}</div>
      <div class="s">买点 {ss.buys} · 卖点 {ss.sells}</div>
    </div>
    <div>
      <div class="k">已满 20 日</div>
      <div class="v">{ss.matured}</div>
      <div class="s">其余太新，还没有结果</div>
    </div>
    <div>
      <div class="k">方向有效</div>
      <div class="v">{ss.hit} <span class="u">/ {ss.matured}</span></div>
      <div class="s">占 {Math.round(ss.rate * 100)}%，强于随机但不足以单独择时</div>
    </div>
    <div>
      <div class="k">2025 年起</div>
      <div class="v">{events.filter((e) => e.date >= '2025-01-01').length}</div>
      <div class="s">最近两年的信号数</div>
    </div>
  </div>

  <div class="shead" aria-hidden="true">
    <span>日期</span>
    <span>指数</span>
    <span>方向</span>
    <span class="num">当日</span>
    <span class="num">连续 / 合计</span>
    <span class="num">后 20 日</span>
  </div>

  {byYear.map((y) => (
    <section class="band reveal">
      <div class="band-head">
        <h2>{y.year} <span class="cnt">{y.rows.length}</span></h2>
        <span class="side">
          买 {y.buys} · 卖 {y.rows.length - y.buys}
          {y.matured > 0 && <> · 有效 <span class="fig">{y.hit}/{y.matured}</span></>}
        </span>
      </div>
      <div class="slist">
        {y.rows.map((e) => (
          <a class="srow" href={`/index/${e.slug}.html`}>
            <span class="sd">{e.date}</span>
            <span class="sn2">{bySlug.get(e.slug)?.name ?? e.slug}</span>
            <span class={`pill ${e.side > 0 ? 'buy' : 'sell'}`}>{side(e.side)}</span>
            <span class="sv2">{signed(e.amount)}</span>
            <span class="sv2 m">{e.days} 天 / {signed(e.total, 0)}</span>
            <span class={`sv2 ${e.post20 > 0 ? 'pos' : 'm'}`}>{e.post20 === null ? '—' : pct(e.post20, 1)}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p class="tail">
    触发：|F| ≥ max({meta.params.floor_yi} 亿, {meta.params.ratio * 100}% × 该指数 ETF 合计规模)，封顶 {meta.params.cap_yi} 亿；
    成分 ETF ≥2 只时同向只数 ≥ max(2, 60%)。<a href="/about.html">口径说明 →</a>
  </p>
</Base>
