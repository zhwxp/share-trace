---
import Base from '../layouts/Base.astro';
import { load, marketToday } from '../lib/data.mjs';
import { signed } from '../lib/format.mjs';
import { V } from '../lib/asset.mjs';

const { meta } = load();
const t = marketToday();

// 月度汇总
const byMonth = new Map();
for (const d of t.history) {
  const key = d.date.slice(0, 7);
  let m = byMonth.get(key);
  if (!m) byMonth.set(key, (m = { month: key, flow: 0, inDays: 0, outDays: 0, maxAbs: 0, maxDate: d.date, n: 0 }));
  m.flow += d.flow;
  m.n += 1;
  if (d.flow > 0) m.inDays += 1;
  else if (d.flow < 0) m.outDays += 1;
  if (Math.abs(d.flow) > m.maxAbs) {
    m.maxAbs = Math.abs(d.flow);
    m.maxDate = d.date;
  }
}
const months = [...byMonth.values()]
  .map((m) => ({ ...m, flow: Math.round(m.flow * 100) / 100 }))
  .sort((a, b) => (a.month < b.month ? 1 : -1));

const best = months.reduce((a, b) => (b.flow > a.flow ? b : a), months[0] ?? null);
const worst = months.reduce((a, b) => (b.flow < a.flow ? b : a), months[0] ?? null);
const maxDay = t.history.reduce((a, b) => (Math.abs(b.flow) > Math.abs(a.flow) ? b : a), t.history[0] ?? null);

const years = [...new Set(months.map((m) => m.month.slice(0, 4)))].sort().reverse();
const byYear = years.map((y) => {
  const ys = months.filter((m) => m.month.startsWith(y));
  return {
    year: y,
    rows: ys,
    flow: Math.round(ys.reduce((s, m) => s + m.flow, 0) * 100) / 100,
    nIn: ys.filter((m) => m.flow > 0).length,
    nOut: ys.filter((m) => m.flow <= 0).length,
  };
});

const asc = months.slice().reverse();
const chart = { labels: asc.map((m) => m.month.slice(2)), values: asc.map((m) => m.flow) };
const generated = meta.generated_at.slice(0, 16).replace('T', ' ');
---

<Base title="ShareTrace · 资金流" current="stats" echarts stamp={{ date: t.date, generated }}>
  <div class="head reveal">
    <div>
      <h1>资金流</h1>
      <p class="meta">
        57 只国家队 ETF 的合计净申赎，按自然月汇总。份额增加是一级市场申购，与二级市场成交无关。
        深市 10 只 2026-10-21 起才计入。
      </p>
    </div>
    <div class="right">
      <b>{months.length}</b> 个月<br />
      <b>{t.history.length}</b> 个交易日
    </div>
  </div>

  <div class="statrow reveal">
    <div>
      <div class="k">最强月</div>
      <div class="v">{signed(best.flow, 0)}</div>
      <div class="s">{best.month} · 亿元</div>
    </div>
    <div>
      <div class="k">最弱月</div>
      <div class="v">{signed(worst.flow, 0)}</div>
      <div class="s">{worst.month} · 亿元</div>
    </div>
    <div>
      <div class="k">净申购月份</div>
      <div class="v">{months.filter((m) => m.flow > 0).length} <span class="u">/ {months.length}</span></div>
      <div class="s">按月看正负月份的比例</div>
    </div>
    <div>
      <div class="k">单日最大</div>
      <div class="v">{signed(maxDay.flow, 0)}</div>
      <div class="s">{maxDay.date} · 亿元</div>
    </div>
  </div>

  <section class="panel reveal" style="margin-top:24px">
    <div class="panel-head">
      <h2>按月合计</h2>
      <span class="note">上为净申购，下为净赎回 · 亿元</span>
    </div>
    <div id="monthChart" class="chart"></div>
  </section>

  <div class="mhead" aria-hidden="true">
    <span>年份</span><span class="num">合计</span><span class="num">月份</span>
    <span class="num">净申购月</span><span class="num">净赎回月</span>
  </div>
  <div class="mlist">
    {byYear.map((y) => (
      <div class="mrow yrow">
        <span class="mm">{y.year}</span>
        <span class="mv">{signed(y.flow)}</span>
        <span class="mv m">{y.rows.length}</span>
        <span class="mv m">{y.nIn}</span>
        <span class="mv m">{y.nOut}</span>
        <span class="ymini">{y.nIn} 个月申购 / {y.nOut} 个月赎回</span>
      </div>
    ))}
  </div>

  <p class="tail">
    原始数据：<a href="/data/history.csv">逐日明细 CSV →</a>
    · 口径与已知限制见 <a href="/about.html">口径说明</a>。
  </p>

  <script is:inline type="application/json" id="month-data" set:html={JSON.stringify(chart)} />
  <script is:inline src={`/assets/charts.js?v=${V}`}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('monthChart');
      var raw = document.getElementById('month-data');
      if (!el || !raw || !window.Charts) return;
      var d = JSON.parse(raw.textContent);
      function draw() {
        Charts.diverging(el, {
          labels: d.labels,
          values: d.values,
          above: '净申购',
          below: '净赎回',
          format: function (v) { return Math.abs(v) >= 1000 ? Math.round(v / 100) / 10 + 'k' : Math.round(v); },
          height: 210,
          mark: [d.values.length - 1],
          markLabel: '本月',
          markSide: 'above'
        });
      }
      draw();
      var t;
      window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(draw, 160); });
    })();
  </script>
</Base>

<style>
  @media (min-width: 641px) {
    .mhead, .mrow {
      grid-template-columns: 96px 150px 88px 96px 96px;
    }
  }
  .ymini {
    display: none;
  }
  @media (max-width: 640px) {
    .statrow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .yrow {
      grid-template-columns: auto auto minmax(0, 1fr);
      grid-template-areas: none;
      gap: 4px 10px;
    }
    .yrow > span {
      grid-area: auto;
    }
    .yrow > span:nth-child(3),
    .yrow > span:nth-child(4),
    .yrow > span:nth-child(5) {
      display: none;
    }
    .yrow .ymini {
      display: block;
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }
  }
</style>
